pipeline {
  agent any

  options {
    timestamps()
    skipStagesAfterUnstable()
    timeout(time: 20, unit: 'MINUTES')
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Override Docker image tag')
  }

  environment {
    PROJECT_ID   = 'master-project-504311'
    REGION       = 'asia-south1'
    CLUSTER_NAME = 'gke-cluster'
    IMAGE_NAME   = 'flask-app'
    AR_REPO      = 'docker-repo'
    TAG          = "${params.IMAGE_TAG ?: BUILD_NUMBER}"
    AR_IMAGE     = "${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/${IMAGE_NAME}:${TAG}"
    K8S_NAMESPACE = 'production'
    DEPLOYMENT    = 'flask-app'
    CONTAINER     = 'flask-app'
  }

  stages {

    stage('Authenticate to GCP') {
      steps {
        sh '''
          set -e
          gcloud auth list
          gcloud config set project ${PROJECT_ID}
          gcloud auth configure-docker ${REGION}-docker.pkg.dev --quiet
          set -x
        '''
      }
    }

    stage('App Sanity Check') {
      steps {
        dir('app') {
          sh 'python3 -m py_compile src/app.py'
        }
      }
    }

    stage('Build Docker Image') {
      steps {
        dir('app') {
          sh """
            docker build \
              --pull \
              --label git_commit=${GIT_COMMIT} \
              --label build_number=${BUILD_NUMBER} \
              -t ${AR_IMAGE} .
          """
        }
      }
    }

    stage('Scan Image with Trivy') {
      steps {
        script {
          sh """
            trivy image \
              --severity CRITICAL \
              --ignore-unfixed=false \
              --format json \
              --output trivy-report.json \
              ${AR_IMAGE}
          """

          def report = readJSON file: 'trivy-report.json'

          def fixableCritical = []
          def unfixedCritical = []

          report.Results?.each { result ->
            result.Vulnerabilities?.each { vuln ->
              if (vuln.Severity == 'CRITICAL') {
                if (vuln.Status == 'fixed') {
                  fixableCritical << vuln
                } else {
                  unfixedCritical << vuln
                }
              }
            }
          }

          echo "Fixable CRITICAL vulnerabilities: ${fixableCritical.size()}"
          echo "Unfixed/Deferred CRITICAL vulnerabilities: ${unfixedCritical.size()}"

          if (fixableCritical.size() > 0) {
            echo "Fixable CRITICAL vulnerabilities found:"
            fixableCritical.each {
              echo "${it.PkgName} - ${it.VulnerabilityID} - ${it.Status} - Fixed: ${it.FixedVersion}"
            }
            error("Build blocked: fixable CRITICAL vulnerabilities detected.")
          }

          if (unfixedCritical.size() > 0) {
            echo "CRITICAL vulnerabilities exist, but no fix is currently available:"
            unfixedCritical.each {
              echo "${it.PkgName} - ${it.VulnerabilityID} - ${it.Status}"
            }
            currentBuild.result = 'UNSTABLE'
          }

          if (fixableCritical.size() == 0 && unfixedCritical.size() == 0) {
            echo "No CRITICAL vulnerabilities found."
          }
        }
      }
    }

    stage('Push Image to Artifact Registry') {
      steps {
        retry(2) {
          sh "docker push ${AR_IMAGE}"
        }
      }
    }

    stage('Deploy to GKE') {
      steps {
        sh """
          gcloud container clusters get-credentials ${CLUSTER_NAME} \
            --region ${REGION} \
            --project ${PROJECT_ID}

          kubectl set image deployment/${DEPLOYMENT} \
            ${CONTAINER}=${AR_IMAGE} \
            -n ${K8S_NAMESPACE}
        """
      }
    }

    stage('Verify Rollout') {
      steps {
        script {
          def status = sh(
            script: """
              kubectl rollout status deployment/${DEPLOYMENT} \
                -n ${K8S_NAMESPACE} \
                --timeout=120s
            """,
            returnStatus: true
          )

          if (status != 0) {
            echo "Rollout failed. Attempting rollback..."

            sh """
              kubectl rollout undo deployment/${DEPLOYMENT} \
                -n ${K8S_NAMESPACE}
            """

            error("Deployment failed and rollback executed.")
          }
        }
      }
    }
  }
}