pipeline {
  agent any

  options {
    timestamps()
    skipStagesAfterUnstable()
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '', description: 'Override Docker image tag')
  }

  environment {
    PROJECT_ID   = 'plasma-hope-457211-d7'
    VM_ZONE      = 'us-central1-a' 
    IMAGE_NAME   = 'flask-app'
    TAG          = "${params.IMAGE_TAG ?: BUILD_NUMBER}"
    AR_REGION    = 'us-central1'  
    AR_REPO      = 'docker-repo'  
    AR_IMAGE     = "${AR_REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/${IMAGE_NAME}:${TAG}"
  }

  stages {
      
    stage('Build Docker Image') {
      steps {
        dir('auto_remediate_platform/cicd-jenkins/') {
          sh "docker build -t ${AR_IMAGE} ."
        }
      }
    }

    stage('Authenticate to Artifact Registry') {
      steps {
        withCredentials([file(credentialsId: 'gcp-service-account-key', variable: 'SA_KEY')]) {
          sh """
            gcloud config set project ${PROJECT_ID}
            gcloud config set compute/zone ${VM_ZONE}
            gcloud auth activate-service-account --key-file=$SA_KEY
            gcloud auth configure-docker ${AR_REGION}-docker.pkg.dev --quiet
          """
        }
      }
    }

    stage('Push to Artifact Registry') {
      steps {
        retry(2) {
          sh "docker push ${AR_IMAGE}"
        }
      }
    }

    stage('Verify Push') {
      steps {
        sh "gcloud artifacts docker images list ${AR_REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/${IMAGE_NAME} --limit=5"
      }
    }
  }

  post {
    always {
      cleanWs()
    }
    success {
      echo "Image pushed to Artifact Registry: ${AR_IMAGE}"
    }
    failure {
      echo "Pipeline failed. Check logs for details."
    }
  }
}
